[Unit]
Description=Rebuild pi-kv-cache-manager golden in the background when AGENTS.md/skills/extensions change
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/python3 -u %h/src/pi-kv-cache-manager/scripts/golden-watch.py
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
